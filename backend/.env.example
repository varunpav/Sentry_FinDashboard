# Database
DATABASE_URL=postgresql+psycopg2://fintrack:fintrack@localhost:5433/fintrack

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting Plaid access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Plaid (Sandbox) — get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your-plaid-sandbox-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Fraud detection
FRAUD_ANOMALY_THRESHOLD_PERCENTILE=3.0
FRAUD_MIN_TRANSACTIONS_FOR_PERSONAL_MODEL=50
